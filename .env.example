# RadioCare — variables d'environnement (exemple, sans secrets)
# Copier ce fichier vers .env et adapter les valeurs.
# Ne jamais versionner le .env contenant de vrais secrets.

# --- PostgreSQL ---
POSTGRES_USER=radiocare
POSTGRES_PASSWORD=radiocare_password
POSTGRES_DB=radiocare
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# --- MinIO (Bronze / stockage objet) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=bronze

# --- Apache Airflow ---
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://radiocare:radiocare_password@postgres:5432/radiocare
AIRFLOW__WEBSERVER__PORT=8080
AIRFLOW__WEBSERVER__BASE_URL=http://localhost:8080
AIRFLOW__SCHEDULER__ENABLE_SCHEDULING=True

# --- Application ---
RADIOCARE_DATA_DIR=/app/data/generated
RADIOCARE_LOG_LEVEL=INFO
